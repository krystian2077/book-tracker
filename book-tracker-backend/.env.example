# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (used by Django via dj-database-url)
DATABASE_URL=postgres://booktracker:booktracker@localhost:5432/booktracker

# Postgres container (used by docker-compose db service)
POSTGRES_DB=booktracker
POSTGRES_USER=booktracker
POSTGRES_PASSWORD=booktracker

# CORS / CSRF (frontend dev origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth cookies: set to True only when serving over HTTPS (production cross-site)
AUTH_COOKIE_SECURE=False
# In production cross-site (Vercel + Railway) set to "None"; locally "Lax"
AUTH_COOKIE_SAMESITE=Lax

# Google Sign-In (optional). OAuth 2.0 Web client ID from Google Cloud Console.
# Leave empty to disable the "Continue with Google" button.
GOOGLE_OAUTH_CLIENT_ID=

# Google Books API key (optional). Improves ISBN lookup quota for metadata/covers.
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# --- Production (Railway) — example values ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
# DATABASE_URL=          # injected automatically when Postgres is linked
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_SAMESITE=None
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app   # optional; auto-appended to ALLOWED_HOSTS
