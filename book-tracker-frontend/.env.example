# Base URL of the backend API (no trailing slash).
# Local dev:
VITE_API_BASE_URL=http://localhost:8000

# Production (Vercel): optional — if unset, the build defaults to the Railway URL
# baked into the client. You can also set it explicitly:
# VITE_API_BASE_URL=https://your-app.up.railway.app

# Google Sign-In (optional). OAuth 2.0 Web client ID from Google Cloud Console.
# Must match GOOGLE_OAUTH_CLIENT_ID on the backend. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
